{
  "type": "panel",
  "items": {
    "enabled": {
      "type": "checkbox",
      "label": "Enabled",
      "default": false
    },
    "aliasId": {
      "type": "text",
      "label": "Alias ID",
      "default": "",
      "help": "Optional ID to use in the mapped MongoDB document instead of the ioBroker datapoint ID."
    },
    "changesOnly": {
      "type": "checkbox",
      "label": "Log changes only",
      "default": true
    },
    "debounceTime": {
      "type": "number",
      "label": "Debounce time (ms)",
      "default": 0
    },
    "blockTime": {
      "type": "number",
      "label": "Block time (ms)",
      "default": 0
    },
    "changesRelogInterval": {
      "type": "number",
      "label": "Relog unchanged value after (seconds)",
      "default": 0
    },
    "changesMinDelta": {
      "type": "number",
      "label": "Minimum change from last logged value",
      "default": 0
    },
    "ignoreZero": {
      "type": "checkbox",
      "label": "Ignore 0 and null values",
      "default": false
    }
  }
}
